# MongoDB connection (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=framex_leadflow

# Auth (required) — must be changed to a strong random value before production
JWT_SECRET=change-me-to-a-long-random-secret

# CORS (optional) — restrict to your deployed domain in production
CORS_ORIGINS=*

# Demo account overrides (optional) — defaults shown are used if unset
DEMO_ADMIN_EMAIL=admin@framex.com
DEMO_ADMIN_PASSWORD=admin123
DEMO_STAFF_EMAIL=staff@framex.com
DEMO_STAFF_PASSWORD=staff123

# OCR provider (optional) — 'mock' (default) or a real provider wired in lib/ocr.js
OCR_PROVIDER=mock

# File storage provider (optional) — 'local' (default, dev only — do not use on
# Vercel, its filesystem is read-only) or 'vercel-blob', wired in lib/storage.js.
# For 'vercel-blob': create a Blob store in the Vercel dashboard (Storage tab),
# which auto-provisions BLOB_READ_WRITE_TOKEN — no need to set it manually here.
STORAGE_PROVIDER=local
